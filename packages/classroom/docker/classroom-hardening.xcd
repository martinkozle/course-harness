<?xml version="1.0" encoding="UTF-8"?>
<!--
  LibreOffice defaults for the Classroom image, installed next to LibreOffice's own registry
  files. The Classroom renders untrusted Course templates, so LibreOffice runs no macros or
  active content (OLE, DDE) and follows no links from the document; the image installs no Java
  runtime. The values are finalized, so a per-run user profile cannot override them.
-->
<oor:data xmlns:xs="http://www.w3.org/2001/XMLSchema"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xmlns:oor="http://openoffice.org/2001/registry">
  <dependency file="main"/>
  <oor:component-data oor:package="org.openoffice.Office" oor:name="Common">
    <node oor:name="Security">
      <node oor:name="Scripting">
        <prop oor:name="MacroSecurityLevel" oor:op="fuse" oor:finalized="true">
          <value>3</value>
        </prop>
        <prop oor:name="DisableMacrosExecution" oor:op="fuse" oor:finalized="true">
          <value>true</value>
        </prop>
        <prop oor:name="DisableActiveContent" oor:op="fuse" oor:finalized="true">
          <value>true</value>
        </prop>
        <prop oor:name="DisableOLEAutomation" oor:op="fuse" oor:finalized="true">
          <value>true</value>
        </prop>
        <prop oor:name="BlockUntrustedRefererLinks" oor:op="fuse" oor:finalized="true">
          <value>true</value>
        </prop>
      </node>
    </node>
  </oor:component-data>
</oor:data>
