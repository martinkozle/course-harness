#!/bin/sh
# LibreOffice for the Classroom image, which renders untrusted Course templates at sync time.
#
# `course_harness.core.slide_preview` runs the first `libreoffice` on PATH, which is this script.
# It runs soffice in a new user and network namespace whose only interface is a loopback that is
# down, so a template cannot reach any network, the host or the Classroom. Docker's default
# seccomp profile refuses unprivileged namespaces (compose.yaml uses seccomp-classroom.json,
# which allows exactly this one); then soffice runs with the network
# (CLASSROOM_RENDER_SANDBOX=auto) or not at all (required, so the Classroom shows plain
# backgrounds). Either way classroom-hardening.xcd turns off macros, active content and links.
set -eu

soffice=/usr/lib/libreoffice/program/soffice

if unshare --user --map-root-user --net true 2>/dev/null; then
	exec unshare --user --map-root-user --net -- "$soffice" "$@"
fi
if [ "${CLASSROOM_RENDER_SANDBOX:-auto}" = required ]; then
	echo "LibreOffice was not run: this container cannot create a network-less sandbox" >&2
	exit 1
fi
exec "$soffice" "$@"
