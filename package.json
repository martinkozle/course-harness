{
	"name": "course-harness-frontend",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite --config frontend/vite.config.ts",
		"lint": "biome lint frontend playwright.config.ts tests/e2e",
		"typecheck": "tsc --noEmit",
		"build": "tsc --noEmit && vite build --config frontend/vite.config.ts",
		"test:e2e": "biome lint frontend playwright.config.ts tests/e2e && tsc --noEmit && vite build --config frontend/vite.config.ts && playwright test"
	},
	"dependencies": {
		"react": "19.2.7",
		"react-dom": "19.2.7"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.4",
		"@playwright/test": "1.61.1",
		"@types/node": "26.1.1",
		"@types/react": "19.2.17",
		"@types/react-dom": "19.2.3",
		"@vitejs/plugin-react": "6.0.3",
		"typescript": "7.0.2",
		"vite": "8.1.5"
	}
}
