{
	"name": "course-harness-workspace",
	"private": true,
	"type": "module",
	"workspaces": ["frontend/*"],
	"scripts": {
		"dev": "bun run --filter @course-harness/harness dev",
		"dev:classroom": "bun run --filter @course-harness/classroom dev",
		"lint": "biome lint frontend playwright.config.ts tests/e2e",
		"typecheck": "tsc --noEmit && bun run --filter './frontend/*' typecheck",
		"build": "bun run --filter './frontend/*' build",
		"test:e2e": "bun run lint && tsc --noEmit && bun run --filter @course-harness/harness build && playwright test"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.13.0",
		"@biomejs/biome": "2.5.4",
		"@playwright/test": "1.61.1",
		"@types/node": "26.1.1",
		"typescript": "7.0.2"
	}
}
