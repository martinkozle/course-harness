# Copy to .env next to compose.yaml and fill in. Never commit .env.

# The Administrator token for /admin, at least 24 characters. Generate one with:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
CLASSROOM_ADMIN_TOKEN=

# The address people use to reach the Classroom, as served by your reverse proxy.
CLASSROOM_PUBLIC_URL=https://classroom.example.org

# Reverse proxies whose X-Forwarded-For/-Proto headers are trusted, comma-separated addresses or
# networks. The default is the gateway of compose.yaml's network, through which a proxy on the
# host connects. Set it to the proxy container's address if the proxy runs in Docker too.
# CLASSROOM_TRUSTED_PROXIES=172.29.81.1

# The host port bound on 127.0.0.1 for the reverse proxy.
# CLASSROOM_PORT=8000

# Seconds between background syncs of every course; 0 turns them off.
# CLASSROOM_FETCH_INTERVAL=900

# `required` never runs LibreOffice without its network-less sandbox: slides get plain
# backgrounds where it cannot be created. `auto` then renders with network access instead.
# CLASSROOM_RENDER_SANDBOX=required

# Any other CLASSROOM_* setting in this file also reaches the Classroom, for example:
# CLASSROOM_FETCH_TIMEOUT=300
# CLASSROOM_MAX_MIRROR_BYTES=1000000000
